{
  "name": "@rabbitlock/cli",
  "version": "0.4.2",
  "description": "One credential policy for every coding agent: per-key host allowlists, approvals and receipts. The agent only holds placeholders.",
  "type": "module",
  "bin": {
    "rabbitlock": "bin/rabbitlock.mjs"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 test/*.test.mjs",
    "prepack": "node scripts/vendor-crypto.mjs"
  },
  "dependencies": {
    "node-forge": "^1.4.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@rabbitlock/crypto-wasm": "*"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "credentials",
    "secrets",
    "policy",
    "approvals",
    "audit",
    "proxy",
    "claude-code",
    "codex",
    "security"
  ],
  "homepage": "https://rabbitlock.com/docs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
